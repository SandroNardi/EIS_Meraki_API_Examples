# .env.example
# ─────────────────────────────────────────────────────────────────────
# Meraki Starter Kit — Environment Variables
#
# 1. Copy this file:           cp .env.example .env
# 2. Fill in your API key below
# 3. Load it before running:   source .env
#
# Get your API key from:
#   Meraki Dashboard → My Profile (top-right) → API access → Generate
# ─────────────────────────────────────────────────────────────────────

export MERAKI_DASHBOARD_API_KEY="your-40-character-api-key-here"

# Used by Terraform's CiscoDevNet/meraki provider
export MERAKI_API_KEY="${MERAKI_DASHBOARD_API_KEY}"

# Used by Ansible's cisco.meraki collection
# (We export the same key under the name Ansible expects)
export ANSIBLE_MERAKI_API_KEY="${MERAKI_DASHBOARD_API_KEY}"