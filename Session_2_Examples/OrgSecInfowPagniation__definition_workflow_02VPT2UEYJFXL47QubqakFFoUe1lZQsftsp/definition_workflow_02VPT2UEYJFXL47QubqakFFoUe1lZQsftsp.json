      {
        "unique_name": "definition_activity_02VPT2VQQ1SRP60vhUX2BNSVrl7m1vpckuw",
        "name": "Execute Python Script",
        "title": "PY - Generate html table",
        "type": "python3.script",
        "base_type": "activity",
        "properties": {
          "action_timeout": 180,
          "continue_on_failure": false,
          "description": "Execute Python Script",
          "display_name": "PY - Generate html table",
          "script": "import json\nimport sys\n\n# Access the first argument passed to the script\n# sys.argv[1] contains the JSON string provided as the first argument\njson_input = sys.argv[1]\ndata = json.loads(json_input)\n\nif data:\n    # Identify headers (excluding nested dictionaries)\n    headers = [key for key in data[0].keys() if isinstance(data[0][key], (str, int, bool, float))]\n    \n    # Generate HTML table string for the 'result' variable\n    html = '<table border=\"1\" style=\"border-collapse: collapse; width: 100%;\">'\n    html += '<thead><tr>'\n    for header in headers:\n        html += f'<th style=\"padding: 8px; background-color: #f2f2f2;\">{header}</th>'\n    html += '</tr></thead>'\n    \n    html += '<tbody>'\n    for entry in data:\n        html += '<tr>'\n        for header in headers:\n            value = entry.get(header, \"\")\n            html += f'<td style=\"padding: 8px;\">{value}</td>'\n        html += '</tr>'\n    html += '</tbody></table>'\n    \n    result = html\nelse:\n    result = \"<p>No data available.</p>\"",
          "script_arguments": [
            "$activity.definition_activity_02VPT2VOY612V1ONKWL3otIFdqNambLMWmO.output.script_queries.final_array$"
          ],
          "script_queries": [
            {
              "script_query": "result",
              "script_query_name": "html_table",
              "script_query_type": "string"
            }
          ],
          "skip_execution": false
        },
        "object_type": "definition_activity"
      },
